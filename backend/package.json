{
  "name": "hubinvest-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API HubInvest",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:seed": "sequelize-cli db:seed:all",
    "db:demo": "sequelize-cli db:seed:all --seeders-path src/database/demo",
    "db:demo:undo": "sequelize-cli db:seed:undo:all --seeders-path src/database/demo",
    "test:critical": "node --test test/critical.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "deepl-node": "^1.28.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "image-size": "^2.0.4",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
