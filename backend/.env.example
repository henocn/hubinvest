NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hubinvest
DB_USER=
DB_PASSWORD=
DB_DIALECT=postgres

JWT_SECRET=
JWT_EXPIRES_IN=8h

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

CORS_ORIGINS=http://localhost:5173,http://localhost:5175
FRONTEND_URL=http://localhost:5173
# Espace équipe (administration, occupants, animateurs)
BACKOFFICE_URL=http://localhost:5175


SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM_NAME=HubInvest
SMTP_FROM_EMAIL=
PASSWORD_RESET_EXPIRES_IN=30m

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_WORKER_ENABLED=true
NOTIFICATIONS_POLL_INTERVAL=15s
NOTIFICATIONS_MAX_ATTEMPTS=5
NOTIFICATIONS_BATCH_SIZE=20

# WhatsApp : l'API met les messages en file, le service notifier/ les envoie (voir notifier/.env.example).
WHATSAPP_ENABLED=false
# Réponse automatique aux messages reçus sur le numéro (webhook https://hub.investir.tg/api/whatsapp/webhook).
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Démarre le service notifier au déploiement.
NOTIFIER_ENABLED=false

DEEPL_AUTH_KEY=

# Agent de l'espace équipe (API Anthropic). Sans clé, l'assistant n'est pas affiché.
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (rapide, peu cher) ; claude-sonnet-5-5 si les réponses ne suffisent pas.
ASSISTANT_MODEL=claude-haiku-5-5
ASSISTANT_EFFORT=low
ASSISTANT_TIMEOUT=60s

FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=false
FTP_BASE_PATH=
