# Propre au service notifier ; la base, le SMTP et les clés VAPID sont lus dans backend/.env.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
# Compte Meta non vérifié : 250 personnes différentes par 24 h (au-delà, repli e-mail).
WHATSAPP_DAILY_RECIPIENTS=250
WHATSAPP_PER_SECOND=5
NOTIFIER_POLL_INTERVAL_MS=10000
# Canaux traités par ce service (tous par défaut).
NOTIFIER_CHANNELS=email,user,whatsapp
